<Window x:Class="MediaSorter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Sorter" Height="680" Width="1100" MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="84"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Source folder" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="SourceBox" Grid.Column="1" Margin="0,0,8,8" Padding="4,3" TextChanged="Paths_Changed"/>
        <Button Grid.Column="2" Content="Browse…" Margin="0,0,0,8" Click="BrowseSource_Click"/>

        <TextBlock Grid.Row="1" Text="Destination folder" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="DestBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" Padding="4,3" TextChanged="Paths_Changed"/>
        <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="0,0,0,8" Click="BrowseDest_Click"/>

        <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,2,0,10">
            <TextBlock Text="Sort by" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ModeCombo" Width="250" Margin="0,0,24,0" SelectedIndex="0" SelectionChanged="ScanOption_Changed">
                <ComboBoxItem Content="Date taken (from photo/video data)"
                              ToolTip="Reads the date stored by the camera or phone. Falls back to a date in the filename, then the file's modified date."/>
                <ComboBoxItem Content="File modified date"
                              ToolTip="Uses only the date the file was last changed, as shown in Explorer. Faster, since files aren't opened."/>
            </ComboBox>
            <CheckBox x:Name="SubfoldersCheck" Content="Include subfolders" IsChecked="True" Click="ScanOption_Changed"/>
            <CheckBox x:Name="FileDateCheck" Content="Use file date when no metadata is found" IsChecked="True" Click="ScanOption_Changed"
                      ToolTip="Otherwise files with no date go to the 'Unknown Date' folder."/>
            <CheckBox x:Name="CopyCheck" Content="Copy instead of move"/>
            <CheckBox x:Name="CleanupCheck" Content="Delete empty folders left in source" IsChecked="True"/>
            <CheckBox x:Name="DownloadCheck" Content="Download OneDrive online-only files" Click="ScanOption_Changed"
                      ToolTip="Online-only files aren't stored on this PC. Ticking this downloads each one so its date can be read. OneDrive must be running, and it can take a long time for large libraries."/>
        </WrapPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ScanButton" Content="1. Scan &amp; Preview" Click="Scan_Click" IsEnabled="False"/>
            <Button x:Name="RunButton" Content="2. Organize" Click="Run_Click" IsEnabled="False" FontWeight="SemiBold"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False"/>
            <Button x:Name="UndoButton" Content="Undo a run…" Click="Undo_Click" Margin="24,0,8,0"/>
            <TextBlock x:Name="FilterHint" VerticalAlignment="Center" Foreground="Gray" Margin="12,0,0,0"
                       Text="Rows in amber have a low-confidence date."/>
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="4" Grid.ColumnSpan="3" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E5E5"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  CanUserSortColumns="True" RowHeight="24">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLowConfidence}" Value="True">
                            <Setter Property="Background" Value="#FFF6DD"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOnlineOnly}" Value="True">
                            <Setter Property="Foreground" Value="Gray"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTextColumn Header="Date taken" Binding="{Binding DateText}" Width="130"/>
                <DataGridTextColumn Header="Date from" Binding="{Binding SourceText}" Width="170"/>
                <DataGridTextColumn Header="Goes to" Binding="{Binding PlannedPath}" Width="3*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="260" Height="16"/>
            <TextBlock x:Name="EtaText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,10,0"
                       Foreground="#555" MinWidth="150" TextAlignment="Right"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="Pick a source and destination folder, then scan."/>
        </DockPanel>
    </Grid>
</Window>
